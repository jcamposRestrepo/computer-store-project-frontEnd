# =============================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como .env.local y rellena los valores reales
# NUNCA subas .env.local a Git
# =============================================

# URL del Backend API
# En desarrollo local: http://localhost:3001
# En producción: la URL de tu backend desplegado (ej: https://tu-api.railway.app)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# =============================================
# FIREBASE - Credenciales de tu proyecto
# Encuéntralas en: Firebase Console > Configuración del proyecto > Tus apps
# =============================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
